{
	"luci-app-ksmbd": {
		"description": "Grant access to LuCI app ksmbd",
		"read": {
			"file": {
				"/etc/ksmbd/ksmbd.conf.template": [ "read" ],
				"/proc/sys/kernel/hostname": [ "read" ]
			},
			"uci": [ "ksmbd" ]
		},
		"write": {
			"file": {
				"/etc/ksmbd/ksmbd.conf.template": [ "write" ]
			},
			"uci": [ "ksmbd" ]
		}
	}
}
