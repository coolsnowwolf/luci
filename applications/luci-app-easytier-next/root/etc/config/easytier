config easytier 'settings'
	option enabled '0'
	option etcmd 'etcmd'
	option network_name 'easytier'
	option network_secret ''
	option ip_dhcp '1'
	option ipaddr '10.144.144.1'
	option ip6addr ''
	option external_node 'tcp://public.easytier.top:11010'
	option rpc_port '15888'
	option dev_name 'easytier0'
	option encryption_algorithm 'aes-gcm'
	option multi_thread '0'
	option tunnel_snat '0'
	option allow_wan '0'
	option web_config 'udp://127.0.0.1:22020/admin'
	option machine_id ''
	option web_enabled '0'
	option web_html_port '22020'
	option web_dir '/etc/easytier'
	list peeradd 'tcp://public.easytier.top:11010'
